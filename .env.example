# === REQUIRED for this hackathon ===

# NASA Earthdata (required for MERRA-2/GLDAS/AIRS downloads & Giovanni)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Meteomatics Weather API (1,000 queries/day, hackathon-duration access)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# === OPTIONAL / not needed for this challenge ===

# Microsoft Planetary Computer (no account needed; token only for higher rate limits)
PLANETARY_COMPUTER_API_KEY=

# GoDaddy free domain + 1 year hosting (only if you claim that global offer)
GODADDY_API_KEY=
GODADDY_API_SECRET=

# GitHub (PAT, not password) - for repo pushes / Copilot
GITHUB_TOKEN=

# === NOT NEEDED (skip unless you want ML/big-data tooling) ===
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# App config
APP_ENV=development
PORT=3000