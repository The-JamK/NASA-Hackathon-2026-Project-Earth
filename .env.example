# NASA Earthdata (required for MERRA-2/GLDAS/AIRS downloads & Giovanni)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Meteomatics Weather API (hackathon-duration access)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Cloud hosting (pick one or both)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Microsoft Planetary Computer (optional token for higher rate limits)
PLANETARY_COMPUTER_API_KEY=

# GoDaddy/Porkbun domain (if you claim the free domain offer)
GODADDY_API_KEY=
GODADDY_API_SECRET=

# GitHub (PAT, not password)
GITHUB_TOKEN=

# App config
APP_ENV=development
PORT=3000