# Secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.venv/

# Python bytecode and test cache
__pycache__/
*.py[cod]
.pytest_cache/

# Build output, never committed. The Pages workflow builds dist/ and publishes it
# at the site root, so the deployed URLs carry no /dist/ segment and the folder
# cannot drift out of sync with src/ the way a committed copy did (that drift is
# how ocean.json, seaice.json and countries.json once shipped missing).
dist/
build/
.next/
data/cache/

# OS/editor
.DS_Store
*.log

# Local preview scaffolding (session-specific preview hosts)
.preview.vite.config.mjs