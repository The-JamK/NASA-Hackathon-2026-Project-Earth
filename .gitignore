# Secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.venv/

# Python bytecode and test cache
__pycache__/
*.py[cod]
.pytest_cache/

# Build output. dist/ is committed on purpose because GitHub Pages serves this
# repository folder, so the built site lives in Git. It is deliberately NOT
# ignored: with an ignore rule here, every file a rebuild *adds* to dist/ was
# dropped silently, which is how ocean.json, seaice.json and countries.json once
# shipped to GitHub Pages missing while the files that existed to begin with kept
# updating. Check `git status` after a build instead of muting it.
build/
.next/
data/cache/

# OS/editor
.DS_Store
*.log

# Local preview scaffolding (session-specific preview hosts)
.preview.vite.config.mjs